#!/bin/sh -efu
# SPDX-License-Identifier: GPL-3.0-or-later
#
# kernel-install(8) plugin: build initramfs or UKI with make-initrd.

COMMAND="$1"
KERNEL_VERSION="$2"
KERNEL_IMAGE="${4-}"

[ "$COMMAND" = add ] || exit 0

# initrd passed on the command line
[ "$#" -le 4 ] || exit 0

[ "${KERNEL_INSTALL_IMAGE_TYPE-}" != uki ] || exit 0
[ "${KERNEL_INSTALL_INITRD_GENERATOR:-make-initrd}" = make-initrd ] || exit 0

STAGING="${KERNEL_INSTALL_STAGING_AREA:?}"

verbose=
[ "${KERNEL_INSTALL_VERBOSE:-0}" -eq 0 ] || verbose=-v

if [ "${KERNEL_INSTALL_LAYOUT-}" = uki ] && [ "${KERNEL_INSTALL_UKI_GENERATOR-}" = make-initrd ]; then
	exec make-initrd $verbose uki -k "$KERNEL_VERSION" \
		UKI_VMLINUZ="$KERNEL_IMAGE" UKI_IMAGEFILE="$STAGING/uki.efi"
fi

# reuse initrd shipped next to the kernel image
if [ -n "$KERNEL_IMAGE" ] && [ -f "${KERNEL_IMAGE%/*}/initrd" ]; then
	install -m 0600 -- "${KERNEL_IMAGE%/*}/initrd" "$STAGING/initrd"
	exit 0
fi

exec make-initrd $verbose -k "$KERNEL_VERSION" IMAGEFILE="$STAGING/initrd"
